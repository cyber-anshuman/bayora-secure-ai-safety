# ==============================================================================
# Bayora Secure AI Safety Testing Platform - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Isolation & Enforcement
ENABLE_STRICT_EBPF=true
ENABLE_HARDWARE_ANTI_AFFINITY=true
ENABLE_TIMING_QUANTIZATION=true
TIMING_BUCKET_MS=250

# Vault Authority Simulation
VAULT_TOKEN_TTL_MS=60000
VAULT_ALLOW_REFRESH=false

# WORM Cryptographic Audit Storage
WORM_STORAGE_PATH=./logs/worm_audit.jsonl
EXTERNAL_ANCHOR_SERVICE_ENABLED=true
EXTERNAL_ANCHOR_INTERVAL_SEC=60

# Model Worker Configuration
MODEL_WEIGHT_PIN_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
MAX_CANARY_PROBES_PER_CYCLE=4
INFERENCE_TIMEOUT_MS=10000

# Metric Isolation
METRIC_BUCKET_RESOLUTION_MS=10000
