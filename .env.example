# ==============================================================================
# Bayora Secure AI Safety Testing Platform - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Authentication API Keys (Required in production, auto-generated in development)
RED_API_KEY=red_dev_key_example_secret_1234567890
BLUE_API_KEY=blue_dev_key_example_secret_1234567890
AUDITOR_API_KEY=auditor_dev_key_example_secret_1234567890
ADMIN_API_KEY=admin_dev_key_example_secret_1234567890

# Feature Flags
ENABLE_DEMO_ENDPOINTS=true

# Side-Channel & Timing Protections
ENABLE_TIMING_QUANTIZATION=true
TIMING_BUCKET_MS=250

# Vault Authority (HMAC secret must be at least 32 characters)
VAULT_SECRET=bayora_production_vault_secret_min_32_characters_long
VAULT_TOKEN_TTL_MS=900000
VAULT_MAX_LIFETIME_MS=3600000

# WORM Cryptographic Audit Storage (Anchor secret must be at least 32 characters)
WORM_ANCHOR_SECRET=bayora_production_worm_secret_min_32_characters_long
WORM_STORAGE_PATH=./logs/worm_audit.jsonl
EXTERNAL_ANCHOR_SERVICE_ENABLED=true

# Session & Audit Ledger Capacity
SESSION_TTL_MS=3600000
MAX_SESSIONS=500
MAX_AUDIT_ENTRIES=10000
MAX_CONCURRENT_WORKERS=8

# Model Worker Configuration
# If unset or UNPINNED_DEMO_MODEL, verdict reports weightsPinned: false
MODEL_WEIGHT_PIN_HASH=UNPINNED_DEMO_MODEL

# Metric Isolation
METRIC_BUCKET_RESOLUTION_MS=10000
