{
  "name": "bayora-secure-ai-safety",
  "version": "1.0.0",
  "description": "Production Reference Implementation of the Bayora Secure AI Safety Testing Architecture",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/poc_tests.js",
    "test:unit": "node test/weight_integrity.test.js && node test/subsystems_unit.test.js",
    "test:isolation": "node test/worker_isolation.test.js",
    "test:attacks": "node test/attack_sim_tests.js",
    "test:all": "node test/poc_tests.js && node test/weight_integrity.test.js && node test/subsystems_unit.test.js && node test/worker_isolation.test.js && node test/attack_sim_tests.js",
    "test:coverage": "nyc --reporter=text --reporter=lcov npm run test:all"
  },
  "keywords": [
    "ai-safety",
    "red-teaming",
    "sandboxing",
    "information-flow",
    "zero-trust",
    "worm-audit",
    "merkle-tree"
  ],
  "author": "Bayora Architecture Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyber-anshuman/bayora-secure-ai-safety.git"
  },
  "bugs": {
    "url": "https://github.com/cyber-anshuman/bayora-secure-ai-safety/issues"
  },
  "homepage": "https://github.com/cyber-anshuman/bayora-secure-ai-safety#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nyc": "^18.0.0"
  }
}
