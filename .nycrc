{
  "include": ["src/**/*.js"],
  "exclude": [
    "node_modules/**",
    "test/**",
    "coverage/**",
    "public/**",
    "src/sandboxes/workers/**"
  ],
  "reporter": ["text", "lcov"],
  "branches": 75,
  "lines": 85,
  "functions": 85,
  "statements": 85,
  "check-coverage": true,
  "all": false,
  "cache": false
}
